{
    "private": true,
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build-rollup": "pnpm --filter=posthog-js build-rollup",
        "bundle-size:array": "node packages/browser/scripts/compare-array-bundle-size.mjs",
        "clean": "turbo clean",
        "clean:dep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
        "format": "oxfmt --check 'packages/**/*.{ts,tsx,js,jsx,mjs,cjs}' '!packages/rrweb/**' '!packages/**/playground/**' '!packages/**/examples/**'",
        "format:fix": "oxfmt --write 'packages/**/*.{ts,tsx,js,jsx,mjs,cjs}' '!packages/rrweb/**' '!packages/**/playground/**' '!packages/**/examples/**'",
        "lint": "pnpm format && pnpm lint:oxlint && turbo lint",
        "lint:fix": "pnpm lint:oxlint:fix && turbo lint:fix && pnpm format:fix",
        "lint:oxlint": "oxlint -c .oxlintrc.correctness.json packages",
        "lint:oxlint:fix": "oxlint -c .oxlintrc.correctness.json --fix packages",
        "lint:playground": "oxfmt --check 'playground/**/*.{ts,tsx,js,jsx,mjs,json,md}' && oxlint --report-unused-disable-directives-severity error playground",
        "lint:playground:fix": "oxlint --fix --report-unused-disable-directives-severity error playground && oxfmt --write 'playground/**/*.{ts,tsx,js,jsx,mjs,json,md}'",
        "test": "turbo test",
        "test:unit": "turbo test:unit",
        "test:docs-scripts": "node --test \"scripts/docs/__tests__/*.test.js\"",
        "test:functional": "turbo test:functional",
        "test:e2e": "turbo test:e2e",
        "test:mcp-harness": "node packages/mcp/harness/run-all.mjs",
        "build": "turbo build",
        "dev": "turbo dev",
        "package": "export PACKAGE_DEST=$(pwd)/target && turbo package",
        "prepare": "if [ -z \"$CI\" ] && [ \"$PREK\" != \"0\" ] && [ \"$HUSKY\" != \"0\" ] && command -v git >/dev/null 2>&1 && [ -x node_modules/.bin/prek ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then node_modules/.bin/prek install; fi",
        "check:package-tarballs": "node scripts/check-package-tarballs.js",
        "package:watch": "export PACKAGE_DEST=$(pwd)/target && turbo watch package",
        "bump": "pnpm changeset version",
        "generate-references": "pnpm turbo --filter=posthog-js --filter=posthog-node --filter=posthog-react-native generate-references",
        "generate-references:versioned": "GENERATE_VERSIONED_REFERENCES=1 pnpm turbo --filter=posthog-js --filter=posthog-node --filter=posthog-react-native generate-references",
        "check:public-api": "node scripts/check-public-api.js"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.29.8",
        "@j178/prek": "^0.4.14",
        "@microsoft/api-extractor": "^7.58.9",
        "@microsoft/api-extractor-model": "^7.33.8",
        "@microsoft/tsdoc": "^0.15.1",
        "@types/node": "^22.19.1",
        "es-check": "7.2.1",
        "esbuild": "^0.25.0",
        "esbuild-plugin-umd-wrapper": "catalog:",
        "eslint-plugin-compat": "6.2.0",
        "eslint-plugin-react": "^7.37.5",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "rimraf": "^6.1.3",
        "rollup": "catalog:",
        "rollup-plugin-visualizer": "^5.14.0",
        "ts-node": "^10.9.2",
        "turbo": "^2.9.16",
        "typescript": "catalog:"
    }
}
