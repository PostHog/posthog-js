{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    // These are independent workspaces with their own installs, not part of the root audit.
    "ignore": ["**/playground/**", "**/examples/**"],
    "ignoreFiles": ["**/fixtures/**", "**/test_fixtures/**"],
    // Focus on dead declarations, rather than live declarations that only need their export removed.
    "ignoreExportsUsedInFile": true,
    "babel": true,
    "workspaces": {
        ".": {
            "entry": ["compliance/*/adapter.js", "packages/rrweb/vitest.workspace.ts"],
            "project": ["scripts/**", "compliance/**", ".github/**", "packages/rrweb/*.{js,ts}"],
        },
        "packages/browser": {
            // Rollup discovers these with readdirSync, including CDN-only/lazy extension bundles.
            "entry": [
                "src/entrypoints/*.ts",
                ".testcaferc.js",
                "scripts/build-replay-preprocessing-probe.mjs",
                "scripts/summarize-replay-profile.mjs",
            ],
            "playwright": { "config": "playwright.config*.ts" },
        },
        "packages/ai": {
            // tsdown constructs provider entry names dynamically.
            "entry": ["src/*/index.ts", "src/langchain/middleware/index.ts"],
        },
        "packages/react": {
            "entry": ["src/index.ts", "src/slim.ts", "src/surveys/index.ts"],
        },
        "packages/node": {
            "entry": ["src/entrypoints/*.ts", "src/experimental.ts", "example.mjs"],
            // Spawned by the exception-autocapture tests rather than imported.
            "ignoreFiles": ["src/__tests__/extensions/exception-autocapture.{child.cjs,worker.mjs}"],
            // Generated by prebuild; the audit should also work before building.
            "ignoreUnresolved": ["^\\./version$"],
        },
        "packages/core": {
            "entry": ["src/{error-tracking,testing,surveys,utils}/index.ts", "src/vendor/*.ts"],
        },
        "packages/browser-common": {
            // utils/* is a published wildcard subpath export.
            "entry": ["src/{index,config,constants,extension-runtime,pubsub}.ts", "src/utils/*.ts"],
        },
        "packages/browser-next": {
            // Playwright's webServer command builds and serves these without importing them.
            "entry": ["src/{index,core,analytics}.ts", "playwright/fixture.ts", "scripts/serve-browser-tests.mjs"],
        },
        "packages/nuxt": {
            // Nuxt registers composables and version-selected Nitro plugins by path at runtime.
            "entry": ["src/module.ts", "src/runtime/nitro-plugin-v*.ts", "src/runtime/composables/*.ts"],
        },
        "packages/mcp": {
            "entry": ["src/index.ts", "harness/dual-era/{client/run,servers/*}.mjs", "harness/nest-*/src/main.ts"],
            // Generated by generate-version.
            "ignoreUnresolved": ["^\\.\\./version$"],
        },
        "packages/rrweb/rrweb": {
            "entry": ["src/entries/*.ts", "scripts/{repl,stream}.js", "vite.config.entries.js"],
        },
        "packages/rrweb/rrweb-snapshot": {
            "entry": ["src/{index,record,replay}.ts"],
        },
        "packages/rrweb/record": {
            "entry": ["src/index.ts", "rolldown.dts.config.mts"],
        },
        "packages/web": {
            // Generated by prebuild.
            "ignoreUnresolved": ["^\\./version$"],
        },
    },
}
