]
`;

exports[`minimal $feature_flag_called events sends exactly the allowlisted properties when gated and the flag has no experiment 1`] = `
{
  "event": "$feature_flag_called",
  "properties": {
    "$current_url": "http://localhost/",
    "$device_id": "<generated-device-id>",
    "$feature_flag": "test-flag",
    "$feature_flag_evaluated_at": 1700000000000,
    "$feature_flag_has_experiment": false,
    "$feature_flag_id": 42,
    "$feature_flag_request_id": "minimal-request-id",
    "$feature_flag_response": true,
    "$feature_flag_version": 3,
    "$groups": {
      "organization": "org-1",
    },
    "$lib": "web",
    "$lib_version": "<sdk-version>",
    "$pathname": "/",
    "$process_person_profile": true,
    "$referring_domain": "$direct",
    "$session_id": "<generated-session-id>",
    "$window_id": "<generated-window-id>",
    "distinct_id": "<generated-distinct-id>",
    "token": "minimal-flag-snapshot-token",
  },
  "timestamp": "<capture-timestamp>",
  "uuid": "<event-uuid>",
}
`;

