      "organization": {
        "employee_count": 120,
        "industry": "technology",
      },
      "project": {
        "region": "eu-west",
      },
    },
    "groups": {
      "organization": "org-42",
      "project": "project-7",
    },
    "person_properties": {
      "$lib": "web",
      "$lib_version": "<sdk-version>",
      "plan": "enterprise",
      "seats": 25,
    },
    "timezone": "<runtime-timezone>",
    "token": "random fake token",
  },
  "fireCallbackOnDrop": true,
  "method": "POST",
  "timeout": undefined,
  "timestampMode": "body",
  "url": "https://us.i.posthog.com/flags/?v=2",
}
`;

