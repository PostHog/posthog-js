            }
        }
    },
    "files": [
        "dist",
        "package.json"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "test": "pnpm test:rrweb",
        "test:rrweb": "vitest run",
        "test:watch": "vitest watch",
