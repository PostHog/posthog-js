        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "^1.4.0",
        "puppeteer": "^23.11.1"
    },
    "peerDependencies": {
        "@posthog/rrweb": "workspace:*",
        "@posthog/rrweb-utils": "workspace:*"
    }
