{
    "name": "@posthog/rrweb-plugin-console-record",
    "version": "1.0.8",
    "description": "",
    "type": "module",
    "main": "./dist/rrweb-plugin-console-record.umd.cjs",
    "module": "./dist/rrweb-plugin-console-record.js",
    "unpkg": "./dist/rrweb-plugin-console-record.umd.cjs",
    "typings": "dist/index.d.ts",
    "exports": {
        ".": {
