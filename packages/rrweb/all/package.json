{
    "name": "@posthog/rrweb-all",
    "version": "0.0.27",
    "scripts": {
        "dev": "vite build --watch",
        "build": "pnpm check-types && vite build && pnpm build:declarations",
        "build:declarations": "rolldown -c rolldown.dts.config.mts",
        "test": "pnpm test:rrweb",
        "test:rrweb": "vitest run",
        "test:watch": "vitest watch",
        "check-types": "tsc --noEmit",
        "lint": "oxlint src"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PostHog/posthog-js.git"
    },
    "license": "MIT",
    "type": "module",
    "main": "./dist/rrweb-all.cjs",
    "module": "./dist/rrweb-all.js",
    "unpkg": "./dist/rrweb-all.umd.cjs",
    "typings": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/rrweb-all.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/rrweb-all.cjs"
            }
        }
    },
    "files": [
        "build",
        "dist",
        "package.json"
    ],
    "devDependencies": {
        "puppeteer": "^23.11.1",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "^1.4.0",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@posthog/rrweb-types": "workspace:*",
        "@posthog/rrweb-packer": "workspace:*",
        "@posthog/rrweb": "workspace:*"
    },
    "browserslist": [
        "supports es6-class"
    ]
}
