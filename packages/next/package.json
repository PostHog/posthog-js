{
    "name": "@posthog/next",
    "version": "0.9.0",
    "bugs": {
        "url": "https://github.com/PostHog/posthog-js/issues"
    },
    "description": "PostHog integration for Next.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog-js.git",
        "directory": "packages/next"
    },
    "author": {
        "name": "PostHog",
        "email": "engineering@posthog.com",
        "url": "https://posthog.com"
    },
    "type": "module",
    "license": "MIT",
    "keywords": [
        "posthog",
        "nextjs",
        "analytics",
        "feature-flags"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "edge-light": "./dist/index.edge.js",
            "edge": "./dist/index.edge.js",
            "worker": "./dist/index.edge.js",
            "browser": "./dist/index.client.js",
            "react-server": "./dist/index.js",
            "default": "./dist/index.client.js"
        },
        "./pages": {
            "types": "./dist/pages.d.ts",
            "edge-light": "./dist/pages.edge.js",
            "edge": "./dist/pages.edge.js",
            "worker": "./dist/pages.edge.js",
            "browser": "./dist/pages.client.js",
            "react-server": "./dist/pages.js",
            "node": "./dist/pages.js",
            "default": "./dist/pages.client.js"
        },
        "./otel": {
            "types": "./dist/otel.d.ts",
            "edge-light": "./dist/otel.unsupported.js",
            "edge": "./dist/otel.unsupported.js",
            "worker": "./dist/otel.unsupported.js",
            "browser": "./dist/otel.unsupported.js",
            "node": "./dist/otel.js",
            "default": "./dist/otel.unsupported.js"
        }
    },
    "main": "./dist/index.client.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "!src/__tests__"
    ],
    "scripts": {
        "check-types": "tsc --noEmit --project tsconfig.build.json",
        "clean": "rimraf dist",
        "build": "tsc -p tsconfig.build.json && pnpm check:esm-specifiers && pnpm check:pages-router-ssr",
        "dev": "tsc -p tsconfig.build.json --watch",
        "check:esm-specifiers": "node ./scripts/check-relative-esm-specifiers.mjs",
        "check:pages-router-ssr": "node ./scripts/check-pages-router-ssr.mjs",
        "test:unit": "vitest run",
        "test": "pnpm test:unit",
        "lint": "oxlint --report-unused-disable-directives-severity error src",
        "lint:fix": "oxlint --report-unused-disable-directives-severity error src --fix",
        "prepublishOnly": "pnpm lint && pnpm test:unit && pnpm build",
        "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
    },
    "dependencies": {
        "@posthog/core": "workspace:^",
        "@posthog/react": "workspace:^",
        "posthog-js": "workspace:^",
        "posthog-node": "workspace:^",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/context-async-hooks": "^2.10.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@posthog-tooling/tsconfig-base": "workspace:*",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^19.0.0",
        "@vercel/functions": "^3.4.3",
        "next": "^15.5.22",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "catalog:native",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@vercel/functions": ">=1.0.0",
        "next": ">=13.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "@opentelemetry/api": "^1.9.0"
    },
    "peerDependenciesMeta": {
        "@vercel/functions": {
            "optional": true
        },
        "@opentelemetry/api": {
            "optional": true
        }
    },
    "packageManager": "pnpm@10.23.0"
}
