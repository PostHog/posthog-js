{
    "extends": "@posthog-tooling/tsconfig-base",
    "compilerOptions": {
        "rootDir": "..",
        "noEmit": true,
        "target": "ES2024",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["node", "jest", "@playwright/test"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "baseUrl": ".",
        "paths": {
            "@posthog/browser-common/tests/client-conformance": [
                "../browser-common/tests/helpers/client-conformance.ts"
            ]
        }
    },
    "include": ["src/**/*", "tests/**/*", "fixtures/**/*", "playwright/**/*", "playwright.config.ts"]
}
