{
    "name": "@posthog/browser",
    "version": "0.0.3",
    "description": "A small, extension-based PostHog client for modern browsers",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PostHog/posthog-js.git",
        "directory": "packages/browser-next"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "ARCHITECTURE.md",
        "README.md"
    ],
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "require": "./dist/core.js",
            "import": "./dist/core.mjs"
        },
        "./flags": {
            "types": "./dist/flags.d.ts",
            "require": "./dist/flags.js",
            "import": "./dist/flags.mjs"
        },
        "./analytics": {
            "types": "./dist/analytics.d.ts",
            "require": "./dist/analytics.js",
            "import": "./dist/analytics.mjs"
        },
        "./logs": {
            "types": "./dist/logs.d.ts",
            "import": "./dist/logs.mjs",
            "require": "./dist/logs.js"
        }
    },
    "scripts": {
        "clean": "rimraf dist",
        "lint": "oxlint --report-unused-disable-directives-severity error src tests fixtures playwright playwright.config.ts scripts/*.mjs",
        "lint:fix": "oxlint --report-unused-disable-directives-severity error src tests fixtures playwright playwright.config.ts scripts/*.mjs --fix",
        "build": "rslib build",
        "dev": "rslib build -w",
        "test:unit": "vitest run",
        "test:built": "node scripts/check-mixed-module-delivery.mjs",
        "test:browser": "playwright test --config playwright.config.ts",
        "test:capture-v1-live": "pnpm build && node scripts/check-capture-v1-live.mjs",
        "test:mixed-modules": "rslib build && node scripts/check-mixed-module-delivery.mjs",
        "check-types": "node node_modules/typescript-legacy/bin/tsc --noEmit --project tsconfig.json",
        "bundle-size": "pnpm build && node scripts/check-bundle-size.mjs",
        "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
    },
    "dependencies": {
        "@posthog/browser-common": "workspace:^",
        "@posthog/types": "workspace:^"
    },
    "devDependencies": {
        "@playwright/test": "1.52.0",
        "@posthog-tooling/tsconfig-base": "workspace:*",
        "@rslib/core": "catalog:",
        "esbuild": "^0.25.0",
        "typescript": "catalog:native",
        "typescript-legacy": "catalog:",
        "vitest": "catalog:"
    }
}
