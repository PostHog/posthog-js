{
    "name": "@posthog/browser",
    "version": "0.1.1",
    "description": "A small, extension-based PostHog client for modern browsers",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PostHog/posthog-js.git",
        "directory": "packages/browser-next"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "ARCHITECTURE.md",
        "README.md"
    ],
    "main": "dist/composition/npm/index.js",
    "module": "dist/composition/npm/index.mjs",
    "types": "dist/composition/npm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/composition/npm/index.d.ts",
            "require": "./dist/composition/npm/index.js",
            "import": "./dist/composition/npm/index.mjs"
        },
        "./core": {
            "types": "./dist/composition/npm/core.d.ts",
            "require": "./dist/composition/npm/core.js",
            "import": "./dist/composition/npm/core.mjs"
        },
        "./flags": {
            "types": "./dist/products/flags/flags.d.ts",
            "require": "./dist/products/flags/flags.js",
            "import": "./dist/products/flags/flags.mjs"
        },
        "./analytics": {
            "types": "./dist/products/analytics/analytics.d.ts",
            "require": "./dist/products/analytics/analytics.js",
            "import": "./dist/products/analytics/analytics.mjs"
        },
        "./logs": {
            "types": "./dist/products/logs/logs.d.ts",
            "import": "./dist/products/logs/logs.mjs",
            "require": "./dist/products/logs/logs.js"
        },
        "./surveys": {
            "types": "./dist/products/surveys/surveys.d.ts",
            "require": "./dist/products/surveys/surveys.js",
            "import": "./dist/products/surveys/surveys.mjs"
        },
        "./autocapture": {
            "types": "./dist/products/autocapture/autocapture.d.ts",
            "require": "./dist/products/autocapture/autocapture.js",
            "import": "./dist/products/autocapture/autocapture.mjs"
        }
    },
    "scripts": {
        "clean": "rimraf dist dist-cdn",
        "lint": "oxlint --report-unused-disable-directives-severity error src snippet tests fixtures playwright playwright*.config.ts scripts/*.mjs",
        "lint:fix": "oxlint --report-unused-disable-directives-severity error src snippet tests fixtures playwright playwright*.config.ts scripts/*.mjs --fix",
        "build": "rslib build",
        "dev": "rslib build -w",
        "test:unit": "vitest run",
        "test:built": "node scripts/check-mixed-module-delivery.mjs && node fixtures/flags-early-access.mjs",
        "test:browser": "pnpm --filter @posthog-tooling/sdk-mock-server build && playwright test --config playwright.config.ts",
        "test:capture-v1-live": "pnpm build && node scripts/check-capture-v1-live.mjs",
        "test:mixed-modules": "rslib build && node scripts/check-mixed-module-delivery.mjs",
        "check-types": "node node_modules/typescript-legacy/bin/tsc --noEmit --project tsconfig.json",
        "bundle-size": "pnpm build && node scripts/check-bundle-size.mjs",
        "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz",
        "test:fixture-server": "pnpm --filter @posthog-tooling/sdk-mock-server build && node --test scripts/serve-browser-tests.test.mjs",
        "build:cdn": "node scripts/build-cdn.mjs",
        "test:snippet": "pnpm --filter @posthog-tooling/sdk-mock-server build && pnpm build:cdn && node scripts/check-cdn-bundle.mjs && playwright test --config playwright.snippet.config.ts",
        "bundle-size:cdn": "pnpm build:cdn && node scripts/check-cdn-bundle.mjs"
    },
    "dependencies": {
        "@posthog/browser-common": "workspace:^",
        "@posthog/types": "workspace:^"
    },
    "devDependencies": {
        "@playwright/test": "1.52.0",
        "@posthog-tooling/sdk-mock-server": "workspace:*",
        "@posthog-tooling/tsconfig-base": "workspace:*",
        "@rslib/core": "catalog:",
        "@rspack/core": "2.1.10",
        "esbuild": "^0.25.0",
        "typescript": "catalog:native",
        "typescript-legacy": "catalog:",
        "vitest": "catalog:"
    }
}
