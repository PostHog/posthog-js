{
    "name": "@posthog/react",
    "version": "1.10.5",
    "bugs": {
        "url": "https://github.com/PostHog/posthog-js/issues"
    },
    "description": "Provides components and hooks for React integrations of PostHog.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PostHog/posthog-js.git",
        "directory": "packages/react"
    },
    "author": "engineering@posthog.com",
    "license": "MIT",
    "homepage": "https://posthog.com/docs/libraries/react",
    "packageManager": "pnpm@10.12.4",
    "scripts": {
        "clean": "rimraf dist",
        "build": "rimraf dist ../browser/react/dist ../browser/react/src && tsdown && pnpm check:build-output",
        "dev": "rimraf dist ../browser/react/dist ../browser/react/src && tsdown --watch",
        "check:build-output": "es-check --module es5 'dist/esm/**/*.js' && es-check es5 'dist/umd/**/*.js' && node scripts/check-build-output.mjs",
        "test:unit": "vitest run",
        "lint": "oxlint --report-unused-disable-directives-severity error src",
        "test:debug": "vitest run",
        "prepublishOnly": "pnpm lint && pnpm test:unit && pnpm build",
        "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
    },
    "main": "dist/umd/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/types/index.d.ts",
    "files": [
        "dist",
        "src",
        "surveys",
        "slim"
    ],
    "peerDependencies": {
        "@types/react": ">=16.8.0",
        "posthog-js": ">=1.257.2",
        "react": ">=16.8.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@babel/preset-env": "catalog:",
        "@babel/preset-react": "catalog:",
        "@babel/preset-typescript": "catalog:",
        "@testing-library/dom": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "cross-env": "^7.0.3",
        "posthog-js": "workspace:^",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-test-renderer": "catalog:",
        "tsdown": "0.22.14",
        "tslib": "catalog:",
        "typescript": "catalog:",
        "jsdom": "catalog:",
        "vitest": "catalog:",
        "@ampproject/remapping": "2.3.0"
    }
}
