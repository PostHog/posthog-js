{
    "name": "@posthog/browser-common",
    "version": "0.9.0",
    "description": "Internal shared browser utilities and extension primitives for PostHog Browser SDKs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PostHog/posthog-js.git",
        "directory": "packages/browser-common"
    },
    "sideEffects": [
        "./dist/utils/*-polyfill.js",
        "./dist/utils/*-polyfill.mjs",
        "./dist/utils/uuidv7.js",
        "./dist/utils/uuidv7.mjs"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "typesVersions": {
        "*": {
            "config": [
                "dist/config.d.ts"
            ],
            "constants": [
                "dist/constants.d.ts"
            ],
            "extension-tokens": [
                "dist/extension-tokens.d.ts"
            ],
            "extension-runtime": [
                "dist/extension-runtime.d.ts"
            ],
            "pubsub": [
                "dist/pubsub.d.ts"
            ],
            "utils/*": [
                "dist/utils/*.d.ts"
            ],
            "feature-flags": [
                "dist/feature-flags.d.ts"
            ],
            "feature-flags-config": [
                "dist/feature-flags-config.d.ts"
            ],
            "logs": [
                "dist/logs.d.ts"
            ],
            "logs-types": [
                "dist/logs-types.d.ts"
            ],
            "logs-config": [
                "dist/logs-config.d.ts"
            ],
            "console-logs": [
                "dist/console-logs.d.ts"
            ],
            "surveys": [
                "dist/surveys.d.ts"
            ],
            "surveys-config": [
                "dist/surveys-config.d.ts"
            ],
            "surveys-types": [
                "dist/surveys-types.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "require": "./dist/config.js",
            "import": "./dist/config.mjs"
        },
        "./constants": {
            "types": "./dist/constants.d.ts",
            "require": "./dist/constants.js",
            "import": "./dist/constants.mjs"
        },
        "./extension-tokens": {
            "types": "./dist/extension-tokens.d.ts",
            "require": "./dist/extension-tokens.js",
            "import": "./dist/extension-tokens.mjs"
        },
        "./extension-runtime": {
            "types": "./dist/extension-runtime.d.ts",
            "require": "./dist/extension-runtime.js",
            "import": "./dist/extension-runtime.mjs"
        },
        "./pubsub": {
            "types": "./dist/pubsub.d.ts",
            "require": "./dist/pubsub.js",
            "import": "./dist/pubsub.mjs"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "require": "./dist/utils/*.js",
            "import": "./dist/utils/*.mjs"
        },
        "./feature-flags": {
            "types": "./dist/feature-flags.d.ts",
            "require": "./dist/feature-flags.js",
            "import": "./dist/feature-flags.mjs"
        },
        "./feature-flags-config": {
            "types": "./dist/feature-flags-config.d.ts",
            "require": "./dist/feature-flags-config.js",
            "import": "./dist/feature-flags-config.mjs"
        },
        "./logs": {
            "types": "./dist/logs.d.ts",
            "require": "./dist/logs.js",
            "import": "./dist/logs.mjs"
        },
        "./logs-types": {
            "types": "./dist/logs-types.d.ts",
            "require": "./dist/logs-types.js",
            "import": "./dist/logs-types.mjs"
        },
        "./logs-config": {
            "types": "./dist/logs-config.d.ts",
            "require": "./dist/logs-config.js",
            "import": "./dist/logs-config.mjs"
        },
        "./console-logs": {
            "types": "./dist/console-logs.d.ts",
            "import": "./dist/console-logs.mjs",
            "require": "./dist/console-logs.js"
        },
        "./surveys": {
            "types": "./dist/surveys.d.ts",
            "import": "./dist/surveys.mjs",
            "require": "./dist/surveys.js"
        },
        "./surveys-config": {
            "types": "./dist/surveys-config.d.ts",
            "import": "./dist/surveys-config.mjs",
            "require": "./dist/surveys-config.js"
        },
        "./surveys-types": {
            "types": "./dist/surveys-types.d.ts",
            "import": "./dist/surveys-types.mjs",
            "require": "./dist/surveys-types.js"
        }
    },
    "scripts": {
        "clean": "rimraf dist",
        "lint": "oxlint --report-unused-disable-directives-severity error src tests",
        "lint:fix": "oxlint --report-unused-disable-directives-severity error src tests --fix",
        "build": "rslib build",
        "dev": "rslib build -w",
        "test:unit": "vitest run",
        "check-types": "tsc --noEmit --project tsconfig.build.json",
        "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
    },
    "dependencies": {
        "@posthog/core": "workspace:^",
        "@posthog/types": "workspace:^"
    },
    "devDependencies": {
        "@posthog-tooling/tsconfig-base": "workspace:*",
        "@rslib/core": "catalog:",
        "jsdom": "catalog:",
        "typescript": "catalog:native",
        "vitest": "catalog:"
    }
}
