{
    "name": "@posthog/webpack-plugin",
    "version": "1.7.0",
    "bugs": {
        "url": "https://github.com/PostHog/posthog-js/issues"
    },
    "description": "Webpack plugin for Posthog 🦔",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog-js.git",
        "directory": "packages/webpack-plugin"
    },
    "author": {
        "name": "PostHog",
        "email": "engineering@posthog.com",
        "url": "https://posthog.com"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "dependencies": {
        "@posthog/cli": "catalog:",
        "@posthog/core": "workspace:^",
        "@posthog/plugin-utils": "workspace:^"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.spec.ts"
    ],
    "peerDependencies": {
        "webpack": "^5"
    },
    "devDependencies": {
        "@posthog-tooling/tsconfig-base": "workspace:*",
        "@rslib/core": "catalog:",
        "webpack": "^5",
        "vitest": "catalog:"
    },
    "scripts": {
        "clean": "rimraf dist",
        "lint": "oxlint --report-unused-disable-directives-severity error src",
        "lint:fix": "oxlint --report-unused-disable-directives-severity error src --fix",
        "build": "rslib build",
        "test:unit": "vitest run --passWithNoTests",
        "dev": "rslib build --watch",
        "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
    },
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    }
}
