{
  "manifest_version": 1,
  "sdk": "posthog-node",
  "shards": [
    {
      "id": "flags-single",
      "workloads": [
        "flags.single.boolean",
        "flags.single.rollout",
        "flags.single.variant",
        "flags.single.property",
        "flags.single.regex",
        "flags.single.cohort",
        "flags.single.early",
        "flags.single.late",
        "flags.single.no-match"
      ]
    },
    {
