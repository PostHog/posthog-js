    {
      "id": "capture",
      "workloads": [
        "capture.enqueue.32",
        "capture.enqueue.4096",
        "capture.drain.steady.32",
        "capture.drain.steady.4096",
        "capture.drain.burst.32",
        "capture.drain.burst.4096"
