{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posthog.com/contracts/feature_flag_rules_v2/feature_flag_called_context.schema.json",
  "title": "$feature_flag_called context properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$feature_flag",
    "$feature_flag_response"
  ],
  "properties": {
    "$feature_flag": {
      "type": "string",
      "minLength": 1
    },
    "$feature_flag_response": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "$feature_flag_config_version": {
      "enum": [
        1,
        2
      ]
    },
    "$feature_flag_variant": {
      "type": "string"
    },
    "$feature_flag_rule_id": {
      "type": "string",
      "format": "uuid"
    },
    "$feature_flag_rule_type": {
      "enum": [
        "targeted_release",
        "percentage_rollout",
        "experiment"
      ]
    },
    "$feature_flag_experiment_id": {
      "type": "integer"
    },
    "$feature_flag_reason_code": {
      "type": "string",
      "minLength": 1
    },
    "$feature_flag_reason": {},
    "$feature_flag_forced_variant": {
      "const": true
    }
  },
  "description": "Closed projection of the flag-access context properties. Other existing capture fields are outside this projection. Complete v2 producer context follows the terminal outcome. A tolerant reader drops the whole attribution of a record that breaks its reason's rows (a rule ID without its rule type or the reverse, a rule type the reason does not allow, or a malformed split): for every reason that names a rule, a call may keep the config version and reason code and omit all rule, variant and experiment attribution, while a partly populated or mismatched tuple is rejected. A config version 2 call whose reason code is missing or not registered keeps the raw code, if any, and carries no attribution; a registered code only matches its own reason's branches. A config version 2 call never carries $feature_flag_reason, the reason description that only version 1 calls carry.",
  "allOf": [
    {
      "if": {
        "required": [
          "$feature_flag_config_version"
        ],
        "properties": {
          "$feature_flag_config_version": {
            "const": 2
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "$feature_flag_forced_variant"
              ]
            },
            {
              "required": [
                "$feature_flag_reason"
              ]
            }
          ]
        },
        "oneOf": [
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "targeting_match"
              },
              "$feature_flag_rule_type": {
                "const": "targeted_release"
              }
            },
            "required": [
              "$feature_flag_reason_code",
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
