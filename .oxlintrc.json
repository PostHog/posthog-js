{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "oxc"],
    "jsPlugins": [
        "./tooling/oxlint-plugin-posthog-js/index.js",
        "eslint-plugin-compat",
        {
            "name": "react-js",
            "specifier": "eslint-plugin-react"
        }
    ],
    "categories": {
        "correctness": "error"
    },
    "settings": {
        "react": {
            "version": "18"
        }
    },
    "env": {
        "browser": true,
        "es6": true,
        "jest": true,
        "builtin": true
    },
    "globals": {
        "given": "readonly",
        "global": "readonly",
        "Buffer": "readonly"
    },
    "rules": {
        "prefer-spread": "off",
        "no-empty-pattern": "off",
        "no-import-assign": "off",
        "no-unassigned-vars": "off",
        "no-unreachable": "off",
        "no-unsafe-optional-chaining": "off",
        "no-empty-function": "off",
        "typescript/no-this-alias": "off",
        "typescript/no-explicit-any": "off",
        "no-unused-expressions": "off",
        "no-prototype-builtins": "off",
        "no-empty": "off",
        "no-console": "error",
        "no-unused-vars": "error",
        "jest/no-focused-tests": "error",
        "compat/compat": "error",
        "posthog-js/no-add-event-listener": "error",
        "posthog-js/no-direct-array-check": "error",
        "posthog-js/no-direct-boolean-check": "error",
        "posthog-js/no-direct-date-check": "error",
        "posthog-js/no-direct-document-check": "error",
        "posthog-js/no-direct-file-check": "error",
        "posthog-js/no-direct-form-data-check": "error",
        "posthog-js/no-direct-function-check": "error",
        "posthog-js/no-direct-mutation-observer": "error",
        "posthog-js/no-direct-null-check": "error",
        "posthog-js/no-direct-number-check": "error",
        "posthog-js/no-direct-object-check": "error",
        "posthog-js/no-direct-string-check": "error",
        "posthog-js/no-direct-undefined-check": "error",
        "posthog-js/no-external-replay-imports": "error",
        "posthog-js/no-unsafe-web-global": "off",
        "posthog-js/no-direct-attach-shadow": "off",
        "posthog-js/no-direct-promise-all-settled": "off",
        "posthog-js/no-enum": "off",
        "posthog-js/private-members-leading-underscore": "error"
    },
    "overrides": [
        {
            "files": [
                "packages/core/**",
                "packages/mcp/**",
                "packages/nextjs-config/**",
                "packages/nuxt/**",
                "packages/openfeature-node-provider/**",
                "packages/openfeature-web-provider/**",
                "packages/react-native/**",
                "packages/node/**",
                "packages/web/**",
                "packages/webpack-plugin/**",
                "packages/rollup-plugin/**",
                "examples/**",
                "playground/**",
                "tooling/**"
            ],
            "rules": {
                "no-console": "off",
                "no-unused-vars": "off",
                "posthog-js/private-members-leading-underscore": "off",
                "posthog-js/no-direct-undefined-check": "off",
                "posthog-js/no-direct-boolean-check": "off",
                "posthog-js/no-direct-null-check": "off",
                "posthog-js/no-direct-function-check": "off",
                "posthog-js/no-direct-number-check": "off",
                "posthog-js/no-direct-date-check": "off",
                "posthog-js/no-direct-array-check": "off",
                "typescript/ban-ts-comment": "off",
                "posthog-js/no-add-event-listener": "off",
                "no-constant-condition": "off",
                "compat/compat": "off"
            }
        },
        {
            "files": ["packages/ai/**", "packages/convex/**"],
            "rules": {
                "no-console": "off",
                "no-unused-vars": [
                    "error",
                    {
                        "args": "all",
                        "argsIgnorePattern": "^_",
                        "caughtErrors": "all",
                        "caughtErrorsIgnorePattern": "^_",
                        "destructuredArrayIgnorePattern": "^_",
                        "varsIgnorePattern": "^_",
                        "ignoreRestSiblings": true
                    }
                ],
                "posthog-js/private-members-leading-underscore": "off",
                "posthog-js/no-direct-undefined-check": "off",
                "posthog-js/no-direct-boolean-check": "off",
                "posthog-js/no-direct-null-check": "off",
                "posthog-js/no-direct-function-check": "off",
                "posthog-js/no-direct-number-check": "off",
                "posthog-js/no-direct-date-check": "off",
                "posthog-js/no-direct-array-check": "off",
                "typescript/ban-ts-comment": "off",
                "posthog-js/no-add-event-listener": "off",
                "no-constant-condition": "off",
                "compat/compat": "off"
            }
        },
        {
            "files": ["packages/plugin-utils/**"],
            "rules": {
                "posthog-js/no-direct-undefined-check": "off",
                "compat/compat": "off",
                "no-constant-condition": "off"
            }
        },
        {
            "files": ["packages/browser-next/**"],
            "rules": {
                "compat/compat": "off",
                "posthog-js/no-direct-array-check": "off",
                "posthog-js/no-direct-function-check": "off",
                "posthog-js/no-direct-null-check": "off",
                "posthog-js/no-direct-undefined-check": "off"
            }
        },
        {
            "files": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx"],
            "excludeFiles": ["**/__tests__/**", "**/__mocks__/**", "**/*.spec.*", "**/*.test.*"],
            "rules": {
                "typescript/consistent-type-assertions": [
                    "error",
                    {
                        "assertionStyle": "as",
                        "objectLiteralTypeAssertions": "never"
                    }
                ]
            }
        },
        {
            "files": ["packages/core/src/**"],
            "excludeFiles": ["**/*.spec.*", "**/*.test.*"],
            "rules": {
                "posthog-js/no-unsafe-web-global": "error"
            }
        },
        {
            "files": [
                "packages/core/src/**",
                "packages/react-native/src/**",
                "packages/node/src/**",
                "packages/web/src/**"
            ],
            "excludeFiles": ["**/*.spec.*", "**/*.test.*"],
            "rules": {
                "posthog-js/no-direct-promise-all-settled": "error"
            }
        },
        {
            "files": ["packages/browser/src/**"],
            "rules": {
                "no-restricted-globals": ["error", "document", "window"],
                "posthog-js/no-enum": "error"
            }
        },
        {
            "files": ["packages/browser/src/__tests__/**"],
            "rules": {
                "no-console": "off",
                "no-restricted-globals": "off",
                "compat/compat": "off"
            }
        },
        {
            "files": ["packages/browser/playwright/**"],
            "rules": {
                "posthog-js/no-direct-array-check": "off",
                "posthog-js/no-direct-undefined-check": "off",
                "posthog-js/no-direct-null-check": "off",
                "posthog-js/private-members-leading-underscore": "off",
                "compat/compat": "off",
                "typescript/no-unsafe-function-type": "off",
                "no-empty-pattern": "off",
                "typescript/no-empty-object-type": "off"
            },
            "env": {
                "node": true
            }
        },
        {
            "files": ["packages/browser/playwright/mock-server.mjs"],
            "rules": {
                "no-console": "off"
            }
        },
        {
            "files": ["packages/react/src/**", "packages/react-native/src/**", "packages/react-native-plugin/src/**"],
            "rules": {
                "react/display-name": "error",
                "react/jsx-key": "error",
                "react/jsx-no-comment-textnodes": "error",
                "react/jsx-no-duplicate-props": "error",
                "react/jsx-no-target-blank": "error",
                "react/jsx-no-undef": "error",
                "react/no-children-prop": "error",
                "react/no-danger-with-children": "error",
                "react/no-direct-mutation-state": "error",
                "react/no-find-dom-node": "error",
                "react/no-is-mounted": "error",
                "react/no-render-return-value": "error",
                "react/no-string-refs": "error",
                "react/no-unescaped-entities": "error",
                "react/no-unknown-property": "error",
                "react/react-in-jsx-scope": "error",
                "react/require-render-return": "error",
                "react/rules-of-hooks": "error",
                "react/exhaustive-deps": "warn",
                "react-js/jsx-uses-react": "error",
                "react-js/jsx-uses-vars": "error",
                "react-js/no-deprecated": "error",
                "react-js/prop-types": "error"
            }
        },
        {
            "files": ["packages/react/src/**/*.ts"],
            "rules": {
                "posthog-js/no-direct-null-check": "off"
            }
        },
        {
            "files": ["packages/react/src/**/*.test.*"],
            "rules": {
                "react-js/prop-types": "off"
            }
        },
        {
            "files": ["packages/rrweb/**/*.ts"],
            "rules": {
                "no-console": "off",
                "no-unused-vars": "off",
                "typescript/ban-ts-comment": "off",
                "typescript/no-non-null-assertion": "off",
                "no-useless-escape": "off",
                "prefer-const": "off",
                "no-constant-condition": "off",
                "no-var": "off",
                "no-global-assign": "off",
                "compat/compat": "off",
                "posthog-js/no-add-event-listener": "off",
                "posthog-js/no-direct-array-check": "off",
                "posthog-js/no-direct-boolean-check": "off",
                "posthog-js/no-direct-date-check": "off",
                "posthog-js/no-direct-document-check": "off",
                "posthog-js/no-direct-file-check": "off",
                "posthog-js/no-direct-form-data-check": "off",
                "posthog-js/no-direct-function-check": "off",
                "posthog-js/no-direct-mutation-observer": "off",
                "posthog-js/no-direct-null-check": "off",
                "posthog-js/no-direct-number-check": "off",
                "posthog-js/no-direct-object-check": "off",
                "posthog-js/no-direct-string-check": "off",
                "posthog-js/no-direct-undefined-check": "off",
                "posthog-js/no-external-replay-imports": "off",
                "posthog-js/private-members-leading-underscore": "off"
            }
        },
        {
            "files": ["packages/rrweb/*/src/**/*.ts"],
            "excludeFiles": ["packages/rrweb/rrweb-snapshot/src/utils.ts", "**/*.spec.*", "**/*.test.*"],
            "rules": {
                "posthog-js/no-direct-attach-shadow": "error"
            }
        }
    ],
    "ignorePatterns": [
        "packages/**/playground/**",
        "packages/**/examples/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/lib/**",
        "**/coverage/**",
        "**/.next/**",
        "**/.nuxt/**",
        "**/next-env.d.ts",
        "packages/browser/playground/hydration/vendor/**",
        "packages/core/src/vendor/**",
        "packages/react-native/src/version.ts",
        "packages/react-native/src/tooling/**",
        "packages/web/src/version.ts",
        "packages/browser/**/test_fixtures/**",
        "packages/convex/src/component/_generated/**"
    ]
}
